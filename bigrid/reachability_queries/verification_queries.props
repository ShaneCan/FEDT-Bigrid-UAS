const int N;
// ========== 1. Safety Verification ==========

// Q1.1: Is a collision state reachable? (expected 0 - proves the rules prevent collisions)
P=? [F "collision"]

// Q1.2: Does the system ever reach a collision? (expected 1 - proves the safety invariant)
P=? [G !"collision"]

// Q1.3: Can a collision occur within N steps? (used to check rule completeness)
const int N;
P=? [F<=N "collision"]

// ========== 2. Reachability Verification ==========
// Note: the queries below use P>0 [F ...] and return a boolean (true/false) rather than a probability
// The real system is driven by A* rather than random movement, so what must be verified is reachability
// - state reachable (at least one path exists) -> true
// - state unreachable -> false
// This matches the real system more closely: A* finds an optimal path to the target state

// === 2.1 Basic landing reachability ===

// Q2.1: Can a UAS land successfully? (mission completion - any landing)
// Checks whether at least one path under the bigraph rules leads to a successful landing
P>0 [F "drone_landed"]

// Q2.2: Can a UAS land safely under nominal conditions? (full mission chain - nominal case)
// Checks whether at least one path under the bigraph rules leads to a safe landing
P>0 [F "drone_landed_safe"]

// === 2.2 Landing reachability under faults (refines Q2.1) ===

// Q2.3: Can a low-battery UAS land? (landing capability under low battery)
// Covers both landing at a charging station and landing elsewhere
// Checks whether at least one path under the bigraph rules lets a low-battery UAS land
P>0 [F ("drone_battery_low_landed" | "drone_battery_empty_landed")]

// Q2.4: Can a UAS with a communication failure land? (landing capability under comm failure)
// Checks whether at least one path under the bigraph rules lets such a UAS land
P>0 [F "drone_comm_los_landed"]

// Q2.5: Can a UAS with low battery and comm failure perform an emergency landing? (compound fault)
// Checks whether at least one path under the bigraph rules leads to an emergency landing
P>0 [F ("drone_emergency_landed_1" | "drone_emergency_landed_2")]

// === 2.3 Charging-station reachability ===

// Q2.6: Can a low-battery UAS reach a charging station? (emergency path reachability)
// Checks whether a low-battery UAS (flying or landed) can be at a charging station
// Checks whether at least one path under the bigraph rules reaches a charging station
P>0 [F ("drone_at_charger" & ("drone_battery_low" | "drone_battery_empty"))]

// Q2.7: Can a low-battery UAS land at a charging station and start charging? (charging mechanism)
// Note: once charging starts, the rules ensure it completes (charging_low/charging_empty rules)
// Checks whether at least one path under the bigraph rules reaches this state
P>0 [F ("drone_charging_1" | "drone_charging_2")]

// ========== 3. State Consistency ==========

// Q3.1: Are all landed UAS on the ground layer? (space-state consistency)
P=? [G ("drone_landed" => "drone_at_ground")]

// ========== 4. Rule Completeness ==========

// Note: the queries below use P>0 [F ...] and return a boolean (true/false) for reachability
// The real system is driven by A*, so what must be verified is whether the rules permit the transition
// - state reachable (at least one path exists) -> true, the rule set is complete
// - state unreachable -> false, a rule is missing or the state cannot be reached
// This matches the real system more closely: A* uses the bigraph rules to find an optimal path

// === 4.1 State-transition rule verification ===

// Q4.1: Can a UAS enter emergency flight state 1? (emergency flight state 1 handling rule)
// Checks whether at least one path under the bigraph rules leads to emergency flight state 1
// P>0 [F "drone_flying_emergency_1"]

// Q4.2: Can a UAS enter emergency flight state 2? (emergency flight state 2 handling rule)
// Checks whether at least one path under the bigraph rules leads to emergency flight state 2
// P>0 [F "drone_flying_emergency_2"]

// Q4.3: Can a UAS enter the communication-failure flight state? (communication state-transition rule)
// Checks whether at least one path under the bigraph rules leads to the communication-failure state
// P>0 [F "drone_flying_comm_bad"]

// Q4.4: Can a UAS enter the low-battery flight state? (battery state-transition rule)
// Checks whether at least one path under the bigraph rules leads to the low-battery state
//P>0 [F "drone_flying_battery_low"]

// Q4.5: Can a UAS enter the battery-empty flight state? (battery-empty handling rule)
// Checks whether at least one path under the bigraph rules leads to the battery-empty state
//P>0 [F "drone_flying_battery_empty"]

