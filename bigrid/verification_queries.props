const int N;
// ========== 1. Safety Verification ==========

// Q1.1: Safety invariance (does the system ever reach a collision? expected 1)
P=? [G !"collision"]

// ========== 2. Reachability Verification ==========
// Note: the queries below use P=? [F ...] and return a probability value
// The value is the probability of eventually reaching the target state from the
// initial state within the state space of the PBRS model
// Comparing the values across state-space sizes (500/1000/2000) shows how the model converges

// === 2.1 Basic landing reachability ===

// Q2.1: Probability that a UAS lands successfully (mission completion - any landing)
P=? [F "drone_landed"]

// Q2.2: Probability that a UAS lands safely (full mission chain under nominal conditions)
P=? [F "drone_landed_safe"]

// === 2.2 Landing reachability under faults (refines Q2.1) ===

// Q2.3: Probability that a low-battery UAS lands (at a charging station or elsewhere)
P=? [F ("drone_battery_low_landed" | "drone_battery_empty_landed")]

// Q2.4: Probability that a UAS with a communication failure lands
P=? [F "drone_comm_los_landed"]

// Q2.5: Probability of emergency landing under combined low battery and communication failure
P=? [F ("drone_emergency_landed_1" | "drone_emergency_landed_2")]

// === 2.3 Charging-station reachability ===

// Q2.6: Probability that a low-battery UAS reaches a charging station (emergency path reachability)
P=? [F ("drone_lowbatt_at_charger" | "drone_emptybatt_at_charger")]
// P=? [F ("drone_at_charger" & ("drone_battery_low" | "drone_battery_empty"))]

// Q2.7: Probability that a low-battery UAS lands at a charging station and starts charging
P=? [F ("drone_charging_1" | "drone_charging_2")]

// ========== 3. State Consistency ==========

// Q3.1: Are all landed UAS on the ground layer? (space-state consistency)
// Identity-bound form: drone_landed_in_air = the same UAS is both Landed and at an air locale
// (an air locale is uniquely identified by having a DownRoute; ground cells v0..v8 have none).
// G !"..." must be 1 to actually prove that no landed UAS is left hovering in the air.
P=? [G !"drone_landed_in_air"]
// P=? [G ("drone_landed" => "drone_at_ground")]

// ========== 4. Rule Completeness ==========

// Note: the queries below use P>0 [F ...] and return a boolean (true/false) for reachability
// The real system is driven by A*, so what must be verified is whether the rules permit the transition
// - state reachable (at least one path exists) -> true, the rule set is complete
// - state unreachable -> false, a rule is missing or the state cannot be reached
// This matches the real system more closely: A* uses the bigraph rules to find an optimal path

// === 4.1 State-transition rule verification ===

// Q4.1: Can a UAS enter emergency flight state 1? (emergency flight state 1 handling rule)
// Checks whether at least one path under the bigraph rules leads to emergency flight state 1
// P>0 [F "drone_flying_emergency_1"]

// Q4.2: Can a UAS enter emergency flight state 2? (emergency flight state 2 handling rule)
// Checks whether at least one path under the bigraph rules leads to emergency flight state 2
// P>0 [F "drone_flying_emergency_2"]

// Q4.3: Can a UAS enter the communication-failure flight state? (communication state-transition rule)
// Checks whether at least one path under the bigraph rules leads to the communication-failure state
// P>0 [F "drone_flying_comm_bad"]

// Q4.4: Can a UAS enter the low-battery flight state? (battery state-transition rule)
// Checks whether at least one path under the bigraph rules leads to the low-battery state
//P>0 [F "drone_flying_battery_low"]

// Q4.5: Can a UAS enter the battery-empty flight state? (battery-empty handling rule)
// Checks whether at least one path under the bigraph rules leads to the battery-empty state
//P>0 [F "drone_flying_battery_empty"]

