ctrl Locale = 1;
atomic fun ctrl LocID(v) = 0;
atomic ctrl ChargingStation = 0;
atomic ctrl Route = 1;
atomic ctrl LeftRoute = 1;
atomic ctrl RightRoute = 1;
atomic ctrl ForwardRoute = 1;
atomic ctrl BackRoute = 1;
atomic ctrl ForwardLeftRoute = 1;
atomic ctrl ForwardRightRoute = 1;
atomic ctrl BackLeftRoute = 1;
atomic ctrl BackRightRoute = 1;
atomic ctrl UpRoute = 1;
atomic ctrl DownRoute = 1;
ctrl OccupiedBy = 0;
atomic ctrl Bad = 0;
atomic ctrl ObstacleOrWeather = 0;
ctrl Drone = 1;
ctrl ID = 0;
ctrl Status = 0;
ctrl Battery = 0;
atomic ctrl Normal = 0;
ctrl Communication = 0;
atomic ctrl Low = 0;
atomic ctrl Empty = 0;
atomic ctrl Landed = 0;
atomic ctrl Flying = 0;
atomic ctrl D0 = 0;
atomic ctrl D1 = 0;
atomic ctrl D2 = 0;
atomic ctrl D3 = 0;
atomic ctrl D4 = 0;
atomic ctrl D5 = 0;
atomic ctrl D6 = 0;
atomic ctrl D7 = 0;
atomic ctrl D8 = 0;
atomic ctrl D9 = 0;
atomic ctrl D10 = 0;

react move_forward = 
(Locale{from}.( id | ForwardRoute{to} | OccupiedBy.Drone{d}.( id | Status.Flying ) ) | Locale{to}.( id | OccupiedBy.1 )) 
-[1.0]-> 
(Locale{from}.( id | ForwardRoute{to} | OccupiedBy.1 ) | Locale{to}.( id | OccupiedBy.Drone{d}.( id | Status.Flying ) ))
@ [0, 2, 1];

react move_back = 
(Locale{from}.( id | BackRoute{to} | OccupiedBy.Drone{d}.( id | Status.Flying ) ) | Locale{to}.( id | OccupiedBy.1 ))
-[1.0]-> 
(Locale{from}.( id | BackRoute{to} | OccupiedBy.1 ) | Locale{to}.( id | OccupiedBy.Drone{d}.( id | Status.Flying ) )) 
@ [0, 2, 1];

react move_left =
 (Locale{from}.( id | LeftRoute{to} | OccupiedBy.Drone{d}.( id | Status.Flying ) ) | Locale{to}.( id | OccupiedBy.1 )) 
 -[1.0]->
  (Locale{from}.( id | LeftRoute{to} | OccupiedBy.1 ) | Locale{to}.( id | OccupiedBy.Drone{d}.( id | Status.Flying ) )) 
	@ [0, 2, 1];

react move_right =
 (Locale{from}.( id | RightRoute{to} | OccupiedBy.Drone{d}.( id | Status.Flying ) ) | Locale{to}.( id | OccupiedBy.1 ))
  -[1.0]->
	 (Locale{from}.( id | RightRoute{to} | OccupiedBy.1 ) | Locale{to}.( id | OccupiedBy.Drone{d}.( id | Status.Flying ) )) 
	 @ [0, 2, 1];

react move_forward_left =
 (Locale{from}.( id | ForwardLeftRoute{to} | OccupiedBy.Drone{d}.( id | Status.Flying ) ) | Locale{to}.( id | OccupiedBy.1 ))
  -[0.8]->
	 (Locale{from}.( id | ForwardLeftRoute{to} | OccupiedBy.1 ) | Locale{to}.( id | OccupiedBy.Drone{d}.( id | Status.Flying ) )) 
	 @ [0, 2, 1];

react move_forward_right =
 (Locale{from}.( id | ForwardRightRoute{to} | OccupiedBy.Drone{d}.( id | Status.Flying ) ) | Locale{to}.( id | OccupiedBy.1 ))
  -[0.8]->
	 (Locale{from}.( id | ForwardRightRoute{to} | OccupiedBy.1 ) | Locale{to}.( id | OccupiedBy.Drone{d}.( id | Status.Flying ) )) 
	 @ [0, 2, 1];

react move_back_left =
 (Locale{from}.( id | BackLeftRoute{to} | OccupiedBy.Drone{d}.( id | Status.Flying ) ) | Locale{to}.( id | OccupiedBy.1 ))
  -[0.8]->
	 (Locale{from}.( id | BackLeftRoute{to} | OccupiedBy.1 ) | Locale{to}.( id | OccupiedBy.Drone{d}.( id | Status.Flying ) )) 
	 @ [0, 2, 1];

react move_back_right =
 (Locale{from}.( id | BackRightRoute{to} | OccupiedBy.Drone{d}.( id | Status.Flying ) ) | Locale{to}.( id | OccupiedBy.1 ))
  -[0.8]-> 
	(Locale{from}.( id | BackRightRoute{to} | OccupiedBy.1 ) | Locale{to}.( id | OccupiedBy.Drone{d}.( id | Status.Flying ) )) 
	@ [0, 2, 1];

react move_up =
 (Locale{from}.( id | UpRoute{to} | OccupiedBy.Drone{d}.( id | Status.Flying | Battery.Normal | Communication.Normal ) ) | Locale{to}.( id | OccupiedBy.1 ))
  -[0.6]-> 
	(Locale{from}.( id | UpRoute{to} | OccupiedBy.1 ) | Locale{to}.( id | OccupiedBy.Drone{d}.( id | Status.Flying | Battery.Normal | Communication.Normal) )) 
	@ [0, 2, 1];

react move_down =
 (Locale{from}.( id | DownRoute{to} | OccupiedBy.Drone{d}.( id | Status.Flying  ) ) | Locale{to}.( id | OccupiedBy.1 )) 
 -[0.6]-> 
 (Locale{from}.( id | DownRoute{to} | OccupiedBy.1 ) | Locale{to}.( id | OccupiedBy.Drone{d}.( id | Status.Flying  ) )) 
 @ [0, 2, 1];

# ========== Landing Reactions ==========

# Priority landing at charging station - when battery low and comm normal
fun react low_battery_landing_at_charger(v) =
 Locale{loc}.( LocID(v) | ChargingStation | id | UpRoute{up} | OccupiedBy.Drone{d}.( ID.id | Status.Flying | Battery.Low | Communication.Normal ) )
 -[1.0]->
 Locale{loc}.( LocID(v) | ChargingStation | id | UpRoute{up} | OccupiedBy.Drone{d}.( ID.id | Status.Landed | Battery.Low | Communication.Normal ) )
 @ [0, 1];


# Normal landing - drone must be at ground layer (v0-v8) with normal status
# Using parameterized react to cover all 9 ground locations
fun react landing_normal(v) =
 Locale{loc}.( LocID(v) | id | UpRoute{up} | OccupiedBy.Drone{d}.( ID.id | Status.Flying | Battery.Normal | Communication.Normal ) )
 -[0.2]->
 Locale{loc}.( LocID(v) | id | UpRoute{up} | OccupiedBy.Drone{d}.( ID.id | Status.Landed | Battery.Normal | Communication.Normal ) )
 @ [0, 1];

# Emergency landing - when at ground (v0-v8) with battery Empty OR comm bad
fun react emergency_landing_battery(v) =
 Locale{loc}.( LocID(v) | id | UpRoute{up} | OccupiedBy.Drone{d}.( ID.id | Status.Flying | Battery.Empty | Communication.Normal ) )
 -[1.0]->
 Locale{loc}.( LocID(v) | id | UpRoute{up} | OccupiedBy.Drone{d}.( ID.id | Status.Landed | Battery.Empty | Communication.Normal ) )
 @ [0, 1];

fun react emergency_landing_comm(v) =
 Locale{loc}.( LocID(v) | id | UpRoute{up} | OccupiedBy.Drone{d}.( ID.id | Status.Flying | Battery.Normal | Communication.Bad ) )
 -[1.0]->
 Locale{loc}.( LocID(v) | id | UpRoute{up} | OccupiedBy.Drone{d}.( ID.id | Status.Landed | Battery.Normal | Communication.Bad ) )
 @ [0, 1];

# Emergency landing - when at ground with both battery Low and comm Bad (compound fault case 1)
fun react emergency_landing_both_1(v) =
 Locale{loc}.( LocID(v) | id | UpRoute{up} | OccupiedBy.Drone{d}.( ID.id | Status.Flying | Battery.Low | Communication.Bad ) )
 -[1.0]->
 Locale{loc}.( LocID(v) | id | UpRoute{up} | OccupiedBy.Drone{d}.( ID.id | Status.Landed | Battery.Low | Communication.Bad ) )
 @ [0, 1];

# Emergency landing - when at ground with both battery Empty and comm Bad (compound fault case 2)
fun react emergency_landing_both_2(v) =
 Locale{loc}.( LocID(v) | id | UpRoute{up} | OccupiedBy.Drone{d}.( ID.id | Status.Flying | Battery.Empty | Communication.Bad ) )
 -[1.0]->
 Locale{loc}.( LocID(v) | id | UpRoute{up} | OccupiedBy.Drone{d}.( ID.id | Status.Landed | Battery.Empty | Communication.Bad ) )
 @ [0, 1];


# ========== Charging Station Reactions ==========

# Charging - when landed at charging station with low battery
react charging_low =
 Locale{loc}.( ChargingStation | id | OccupiedBy.Drone{d}.( ID.id | Status.Landed | Battery.Low | Communication.id ) )
 -[1.0]->
 Locale{loc}.( ChargingStation | id | OccupiedBy.Drone{d}.( ID.id | Status.Landed | Battery.Normal | Communication.id ) )
 @ [0, 1, 2];

react charging_empty =
 Locale{loc}.( ChargingStation | id | OccupiedBy.Drone{d}.( ID.id | Status.Landed | Battery.Empty | Communication.id ) )
 -[1.0]->
 Locale{loc}.( ChargingStation | id | OccupiedBy.Drone{d}.( ID.id | Status.Landed | Battery.Normal | Communication.id ) )
 @ [0, 1, 2];

# Takeoff after charging - drone at charging station with normal battery takes off
react takeoff_from_charging_station =
 Locale{loc}.( ChargingStation | id | OccupiedBy.Drone{d}.( ID.id | Status.Landed | Battery.Normal | Communication.id ) )
 -[1.0]->
 Locale{loc}.( ChargingStation | id | OccupiedBy.Drone{d}.( ID.id | Status.Flying | Battery.Normal | Communication.id ) )
 @ [0, 1, 2];

# ========== Random Status Change Reactions ==========

# Communication failure - randomly happens
react comm_failure =
 Drone{d}.( ID.id | Status.Flying | Battery.id | Communication.Normal )
 -[0.1]->
 Drone{d}.( ID.id | Status.Flying | Battery.id | Communication.Bad )
@ [0, 1];

# Battery consumption - randomly happens
react battery_consumption =
 Drone{d}.( ID.id | Status.Flying | Battery.Normal | Communication.id )
 -[0.3]->
 Drone{d}.( ID.id | Status.Flying | Battery.Low | Communication.id )
@ [0, 1];

# Battery drain - replaced by emergency_move_down_to_empty rules
# react battery_drain =
#  Drone{d}.( ID.id | Status.Flying | Battery.Low | Communication.id )
#  -[0.5]->
#  Drone{d}.( ID.id | Status.Flying | Battery.Empty | Communication.id )
# @ [0, 1];

# ========== Emergency Descent Reactions ==========

# Emergency descent - when battery low or comm bad, prioritize moving down
react emergency_move_down_battery_low =
 (Locale{from}.( id | DownRoute{to} | OccupiedBy.Drone{d}.( ID.id | Status.Flying | Battery.Low | Communication.Normal ) ) | Locale{to}.( id | OccupiedBy.1 ))
 -[1.0]->
 (Locale{from}.( id | DownRoute{to} | OccupiedBy.1 ) | Locale{to}.( id | OccupiedBy.Drone{d}.( ID.id | Status.Flying | Battery.Low | Communication.Normal ) ))
 @ [0, 2, 1];

react emergency_move_down_battery_low_to_empty =
 (Locale{from}.( id | DownRoute{to} | OccupiedBy.Drone{d}.( ID.id | Status.Flying | Battery.Low | Communication.Normal ) ) | Locale{to}.( id | OccupiedBy.1 ))
 -[0.5]->
 (Locale{from}.( id | DownRoute{to} | OccupiedBy.1 ) | Locale{to}.( id | OccupiedBy.Drone{d}.( ID.id | Status.Flying | Battery.Empty | Communication.Normal ) ))
 @ [0, 2, 1];

react emergency_move_down_battery_empty =
 (Locale{from}.( id | DownRoute{to} | OccupiedBy.Drone{d}.( ID.id | Status.Flying | Battery.Empty | Communication.Normal ) ) | Locale{to}.( id | OccupiedBy.1 ))
 -[1.0]->
 (Locale{from}.( id | DownRoute{to} | OccupiedBy.1 ) | Locale{to}.( id | OccupiedBy.Drone{d}.( ID.id | Status.Flying | Battery.Empty | Communication.Normal ) ))
 @ [0, 2, 1];

react emergency_move_down_comm =
 (Locale{from}.( id | DownRoute{to} | OccupiedBy.Drone{d}.( ID.id | Status.Flying | Battery.Normal | Communication.Bad ) ) | Locale{to}.( id | OccupiedBy.1 ))
 -[1.0]->
 (Locale{from}.( id | DownRoute{to} | OccupiedBy.1 ) | Locale{to}.( id | OccupiedBy.Drone{d}.( ID.id | Status.Flying | Battery.Normal | Communication.Bad ) ))
 @ [0, 2, 1];

react emergency_move_down_both_1 =
 (Locale{from}.( id | DownRoute{to} | OccupiedBy.Drone{d}.( ID.id | Status.Flying | Battery.Low | Communication.Bad ) ) | Locale{to}.( id | OccupiedBy.1 ))
 -[1.0]->
 (Locale{from}.( id | DownRoute{to} | OccupiedBy.1 ) | Locale{to}.( id | OccupiedBy.Drone{d}.( ID.id | Status.Flying | Battery.Low | Communication.Bad ) ))
 @ [0, 2, 1];

react emergency_move_down_both_1_to_empty =
 (Locale{from}.( id | DownRoute{to} | OccupiedBy.Drone{d}.( ID.id | Status.Flying | Battery.Low | Communication.Bad ) ) | Locale{to}.( id | OccupiedBy.1 ))
 -[0.5]->
 (Locale{from}.( id | DownRoute{to} | OccupiedBy.1 ) | Locale{to}.( id | OccupiedBy.Drone{d}.( ID.id | Status.Flying | Battery.Empty | Communication.Bad ) ))
 @ [0, 2, 1];

react emergency_move_down_both_2 =
 (Locale{from}.( id | DownRoute{to} | OccupiedBy.Drone{d}.( ID.id | Status.Flying | Battery.Empty | Communication.Bad ) ) | Locale{to}.( id | OccupiedBy.1 ))
 -[1.0]->
 (Locale{from}.( id | DownRoute{to} | OccupiedBy.1 ) | Locale{to}.( id | OccupiedBy.Drone{d}.( ID.id | Status.Flying | Battery.Empty | Communication.Bad ) ))
 @ [0, 2, 1];

# Ground layer (z=0), v5 has an obstacle or weather, v8 has a charging station
big bigraphbasemodel = 
  Locale{c_n2_00__n2_00__0_00}.( LocID("v0") | ChargingStation | ForwardRoute{c_n1_00__n2_00__0_00} | LeftRoute{c_n2_00__n1_00__0_00} | ForwardLeftRoute{c_n1_00__n1_00__0_00} | UpRoute{c_n2_00__n2_00__1_00} | OccupiedBy.Drone{d0}.( ID.D0 | Status.Flying | Battery.Normal | Communication.Normal ) ) 
| Locale{c_n2_00__n1_00__0_00}.( LocID("v1") | ForwardRoute{c_n1_00__n1_00__0_00} | LeftRoute{c_n2_00__0_00__0_00} | RightRoute{c_n2_00__n2_00__0_00} | ForwardLeftRoute{c_n1_00__0_00__0_00} | ForwardRightRoute{c_n1_00__n2_00__0_00} | UpRoute{c_n2_00__n1_00__1_00} | OccupiedBy.Drone{d1}.( ID.D1 | Status.Flying | Battery.Normal | Communication.Normal ) ) 
| Locale{c_n2_00__0_00__0_00}.( LocID("v2") | ForwardRoute{c_n1_00__0_00__0_00} | RightRoute{c_n2_00__n1_00__0_00} | ForwardRightRoute{c_n1_00__n1_00__0_00} | UpRoute{c_n2_00__0_00__1_00} | OccupiedBy.Drone{d2}.( ID.D2 | Status.Flying | Battery.Normal | Communication.Normal ) ) 
| Locale{c_n1_00__n2_00__0_00}.( LocID("v3") | ForwardRoute{c_0_00__n2_00__0_00} | BackRoute{c_n2_00__n2_00__0_00} | LeftRoute{c_n1_00__n1_00__0_00} | ForwardLeftRoute{c_0_00__n1_00__0_00} | BackLeftRoute{c_n2_00__n1_00__0_00} | UpRoute{c_n1_00__n2_00__1_00} | OccupiedBy.1 ) 
| Locale{c_n1_00__n1_00__0_00}.( LocID("v4") | ForwardRoute{c_0_00__n1_00__0_00} | BackRoute{c_n2_00__n1_00__0_00} | LeftRoute{c_n1_00__0_00__0_00} | RightRoute{c_n1_00__n2_00__0_00} | ForwardLeftRoute{c_0_00__0_00__0_00} | ForwardRightRoute{c_0_00__n2_00__0_00} | BackLeftRoute{c_n2_00__0_00__0_00} | BackRightRoute{c_n2_00__n2_00__0_00} | UpRoute{c_n1_00__n1_00__1_00} | OccupiedBy.1 ) 
| Locale{c_n1_00__0_00__0_00}.( LocID("v5") | ForwardRoute{c_0_00__0_00__0_00} | BackRoute{c_n2_00__0_00__0_00} | RightRoute{c_n1_00__n1_00__0_00} | ForwardRightRoute{c_0_00__n1_00__0_00} | BackRightRoute{c_n2_00__n1_00__0_00} | UpRoute{c_n1_00__0_00__1_00} | OccupiedBy.ObstacleOrWeather ) 
| Locale{c_0_00__n2_00__0_00}.( LocID("v6") | BackRoute{c_n1_00__n2_00__0_00} | LeftRoute{c_0_00__n1_00__0_00} | BackLeftRoute{c_n1_00__n1_00__0_00} | UpRoute{c_0_00__n2_00__1_00} | OccupiedBy.1 ) 
| Locale{c_0_00__n1_00__0_00}.( LocID("v7") | BackRoute{c_n1_00__n1_00__0_00} | LeftRoute{c_0_00__0_00__0_00} | RightRoute{c_0_00__n2_00__0_00} | BackLeftRoute{c_n1_00__0_00__0_00} | BackRightRoute{c_n1_00__n2_00__0_00} | UpRoute{c_0_00__n1_00__1_00} | OccupiedBy.1 ) 
| Locale{c_0_00__0_00__0_00}.( LocID("v8") | ChargingStation | BackRoute{c_n1_00__0_00__0_00} | RightRoute{c_0_00__n1_00__0_00} | BackRightRoute{c_n1_00__n1_00__0_00} | UpRoute{c_0_00__0_00__1_00} | OccupiedBy.1 ) 
# Mid layer (z=1)
| Locale{c_n2_00__n2_00__1_00}.( LocID("v9") | ForwardRoute{c_n1_00__n2_00__1_00} | LeftRoute{c_n2_00__n1_00__1_00} | ForwardLeftRoute{c_n1_00__n1_00__1_00} | UpRoute{c_n2_00__n2_00__2_00} | DownRoute{c_n2_00__n2_00__0_00} | OccupiedBy.1 ) 
| Locale{c_n2_00__n1_00__1_00}.( LocID("v10") | ForwardRoute{c_n1_00__n1_00__1_00} | LeftRoute{c_n2_00__0_00__1_00} | RightRoute{c_n2_00__n2_00__1_00} | ForwardLeftRoute{c_n1_00__0_00__1_00} | ForwardRightRoute{c_n1_00__n2_00__1_00} | UpRoute{c_n2_00__n1_00__2_00} | DownRoute{c_n2_00__n1_00__0_00} | OccupiedBy.1 ) 
| Locale{c_n2_00__0_00__1_00}.( LocID("v11") | ForwardRoute{c_n1_00__0_00__1_00} | RightRoute{c_n2_00__n1_00__1_00} | ForwardRightRoute{c_n1_00__n1_00__1_00} | UpRoute{c_n2_00__0_00__2_00} | DownRoute{c_n2_00__0_00__0_00} | OccupiedBy.1 ) 
| Locale{c_n1_00__n2_00__1_00}.( LocID("v12") | ForwardRoute{c_0_00__n2_00__1_00} | BackRoute{c_n2_00__n2_00__1_00} | LeftRoute{c_n1_00__n1_00__1_00} | ForwardLeftRoute{c_0_00__n1_00__1_00} | BackLeftRoute{c_n2_00__n1_00__1_00} | UpRoute{c_n1_00__n2_00__2_00} | DownRoute{c_n1_00__n2_00__0_00} | OccupiedBy.1 ) 
| Locale{c_n1_00__n1_00__1_00}.( LocID("v13") | ForwardRoute{c_0_00__n1_00__1_00} | BackRoute{c_n2_00__n1_00__1_00} | LeftRoute{c_n1_00__0_00__1_00} | RightRoute{c_n1_00__n2_00__1_00} | ForwardLeftRoute{c_0_00__0_00__1_00} | ForwardRightRoute{c_0_00__n2_00__1_00} | BackLeftRoute{c_n2_00__0_00__1_00} | BackRightRoute{c_n2_00__n2_00__1_00} | UpRoute{c_n1_00__n1_00__2_00} | DownRoute{c_n1_00__n1_00__0_00} | OccupiedBy.1 ) 
| Locale{c_n1_00__0_00__1_00}.( LocID("v14") | ForwardRoute{c_0_00__0_00__1_00} | BackRoute{c_n2_00__0_00__1_00} | RightRoute{c_n1_00__n1_00__1_00} | ForwardRightRoute{c_0_00__n1_00__1_00} | BackRightRoute{c_n2_00__n1_00__1_00} | UpRoute{c_n1_00__0_00__2_00} | DownRoute{c_n1_00__0_00__0_00} | OccupiedBy.1 ) 
| Locale{c_0_00__n2_00__1_00}.( LocID("v15") | BackRoute{c_n1_00__n2_00__1_00} | LeftRoute{c_0_00__n1_00__1_00} | BackLeftRoute{c_n1_00__n1_00__1_00} | UpRoute{c_0_00__n2_00__2_00} | DownRoute{c_0_00__n2_00__0_00} | OccupiedBy.1 ) 
| Locale{c_0_00__n1_00__1_00}.( LocID("v16") | BackRoute{c_n1_00__n1_00__1_00} | LeftRoute{c_0_00__0_00__1_00} | RightRoute{c_0_00__n2_00__1_00} | BackLeftRoute{c_n1_00__0_00__1_00} | BackRightRoute{c_n1_00__n2_00__1_00} | UpRoute{c_0_00__n1_00__2_00} | DownRoute{c_0_00__n1_00__0_00} | OccupiedBy.1 ) 
| Locale{c_0_00__0_00__1_00}.( LocID("v17") | BackRoute{c_n1_00__0_00__1_00} | RightRoute{c_0_00__n1_00__1_00} | BackRightRoute{c_n1_00__n1_00__1_00} | UpRoute{c_0_00__0_00__2_00} | DownRoute{c_0_00__0_00__0_00} | OccupiedBy.1 ) 
# Top layer (z=2)
| Locale{c_n2_00__n2_00__2_00}.( LocID("v18") | ForwardRoute{c_n1_00__n2_00__2_00} | LeftRoute{c_n2_00__n1_00__2_00} | ForwardLeftRoute{c_n1_00__n1_00__2_00} | DownRoute{c_n2_00__n2_00__1_00} | OccupiedBy.1 ) 
| Locale{c_n2_00__n1_00__2_00}.( LocID("v19") | ForwardRoute{c_n1_00__n1_00__2_00} | LeftRoute{c_n2_00__0_00__2_00} | RightRoute{c_n2_00__n2_00__2_00} | ForwardLeftRoute{c_n1_00__0_00__2_00} | ForwardRightRoute{c_n1_00__n2_00__2_00} | DownRoute{c_n2_00__n1_00__1_00} | OccupiedBy.1 ) 
| Locale{c_n2_00__0_00__2_00}.( LocID("v20") | ForwardRoute{c_n1_00__0_00__2_00} | RightRoute{c_n2_00__n1_00__2_00} | ForwardRightRoute{c_n1_00__n1_00__2_00} | DownRoute{c_n2_00__0_00__1_00} | OccupiedBy.1 ) 
| Locale{c_n1_00__n2_00__2_00}.( LocID("v21") | ForwardRoute{c_0_00__n2_00__2_00} | BackRoute{c_n2_00__n2_00__2_00} | LeftRoute{c_n1_00__n1_00__2_00} | ForwardLeftRoute{c_0_00__n1_00__2_00} | BackLeftRoute{c_n2_00__n1_00__2_00} | DownRoute{c_n1_00__n2_00__1_00} | OccupiedBy.1 ) 
| Locale{c_n1_00__n1_00__2_00}.( LocID("v22") | ForwardRoute{c_0_00__n1_00__2_00} | BackRoute{c_n2_00__n1_00__2_00} | LeftRoute{c_n1_00__0_00__2_00} | RightRoute{c_n1_00__n2_00__2_00} | ForwardLeftRoute{c_0_00__0_00__2_00} | ForwardRightRoute{c_0_00__n2_00__2_00} | BackLeftRoute{c_n2_00__0_00__2_00} | BackRightRoute{c_n2_00__n2_00__2_00} | DownRoute{c_n1_00__n1_00__1_00} | OccupiedBy.1 ) 
| Locale{c_n1_00__0_00__2_00}.( LocID("v23") | ForwardRoute{c_0_00__0_00__2_00} | BackRoute{c_n2_00__0_00__2_00} | RightRoute{c_n1_00__n1_00__2_00} | ForwardRightRoute{c_0_00__n1_00__2_00} | BackRightRoute{c_n2_00__n1_00__2_00} | DownRoute{c_n1_00__0_00__1_00} | OccupiedBy.1 ) 
| Locale{c_0_00__n2_00__2_00}.( LocID("v24") | BackRoute{c_n1_00__n2_00__2_00} | LeftRoute{c_0_00__n1_00__2_00} | BackLeftRoute{c_n1_00__n1_00__2_00} | DownRoute{c_0_00__n2_00__1_00} | OccupiedBy.1 ) 
| Locale{c_0_00__n1_00__2_00}.( LocID("v25") | BackRoute{c_n1_00__n1_00__2_00} | LeftRoute{c_0_00__0_00__2_00} | RightRoute{c_0_00__n2_00__2_00} | BackLeftRoute{c_n1_00__0_00__2_00} | BackRightRoute{c_n1_00__n2_00__2_00} | DownRoute{c_0_00__n1_00__1_00} | OccupiedBy.1 ) 
| Locale{c_0_00__0_00__2_00}.( LocID("v26") | BackRoute{c_n1_00__0_00__2_00} | RightRoute{c_0_00__n1_00__2_00} | BackRightRoute{c_n1_00__n1_00__2_00} | DownRoute{c_0_00__0_00__1_00} | OccupiedBy.1 ) ;

# ========== Predicates for Analysis ==========

big collision = Locale{locale}.( id | OccupiedBy.( Drone{d}.id | Drone{e}.id | id ) );

# Location predicates - specific drone at specific location
big drone_at_v0 = Locale{locale}.(LocID("v0") | id | OccupiedBy.Drone{d}.id);
big drone_at_v8 = Locale{locale}.(LocID("v8") | id | OccupiedBy.Drone{d}.id);  # Origin (0,0,0)

# Layer predicates - parameterized to check each ground location
fun big drone_at_ground(v) = Locale{locale}.(LocID(v) | id | OccupiedBy.Drone{d}.id);

# Empty location predicate
big v0_empty = Locale{locale}.(LocID("v0") | id | OccupiedBy.1);

# Status predicates
big drone_landed = Drone{d}.( Status.Landed | id );
big drone_flying = Drone{d}.( Status.Flying | id );

# Battery predicates
big drone_battery_empty = Drone{d}.( id | Battery.Empty );
big drone_battery_low = Drone{d}.( id | Battery.Low );
big drone_battery_normal = Drone{d}.( id | Battery.Normal );

# Communication predicates
big drone_comm_bad = Drone{d}.( id | Communication.Bad );
big drone_comm_normal = Drone{d}.( id | Communication.Normal );

# Emergency situation predicates (flying drones with issues)
big drone_flying_battery_low = Drone{d}.( ID.id | Status.Flying | Battery.Low | Communication.Normal );
big drone_flying_battery_empty = Drone{d}.( ID.id | Status.Flying | Battery.Empty | Communication.Normal );
big drone_flying_comm_bad = Drone{d}.( ID.id | Status.Flying | Battery.Normal | Communication.Bad );
big drone_flying_emergency_1 = Drone{d}.( ID.id | Status.Flying | Battery.Low | Communication.Bad );
big drone_flying_emergency_2 = Drone{d}.( ID.id | Status.Flying | Battery.Empty | Communication.Bad );

# Safe landing predicate - parameterized for each ground location
big drone_landed_safe = Drone{d}.( ID.id | Status.Landed | Battery.Normal | Communication.Normal );

# Emergency landing predicate - parameterized for each ground location
big drone_comm_los_landed = Drone{d}.( ID.id | Status.Landed | Battery.Normal | Communication.Bad );
big drone_battery_low_landed = Drone{d}.( ID.id | Status.Landed | Battery.Low | Communication.Normal );
big drone_battery_empty_landed = Drone{d}.( ID.id | Status.Landed | Battery.Empty | Communication.Normal );
big drone_emergency_landed_1 = Drone{d}.( ID.id | Status.Landed | Battery.Low | Communication.Bad );
big drone_emergency_landed_2 = Drone{d}.( ID.id | Status.Landed | Battery.Empty | Communication.Bad );

# Charging station predicates
big drone_at_charger = Locale{locale}.( ChargingStation | id | OccupiedBy.Drone{d}.id );
big drone_charging_1 = Locale{locale}.( ChargingStation | id | OccupiedBy.Drone{d}.( ID.id | Status.Landed | Battery.Low | Communication.id ) );
big drone_charging_2 = Locale{locale}.( ChargingStation | id | OccupiedBy.Drone{d}.( ID.id | Status.Landed | Battery.Empty | Communication.id ) );

big drone_lowbatt_at_charger   = Locale{locale}.( ChargingStation | id | OccupiedBy.Drone{d}.( id | Battery.Low ) );

big drone_emptybatt_at_charger = Locale{locale}.( ChargingStation | id | OccupiedBy.Drone{d}.( id | Battery.Empty ) );

big drone_landed_in_air = Locale{locale}.( DownRoute{down} | id | OccupiedBy.Drone{d}.( id | Status.Landed ) );

begin pbrs
	string ground_locs = {"v0", "v1", "v2", "v3", "v4", "v5", "v6", "v7", "v8"};
	init bigraphbasemodel;
	rules = [
		# Priority 1: charging and take-off
		{charging_low, charging_empty, takeoff_from_charging_station},
		# Priority 3: emergency landing
		{low_battery_landing_at_charger(ground_locs), emergency_landing_comm(ground_locs), emergency_landing_battery(ground_locs), emergency_landing_both_1(ground_locs), emergency_landing_both_2(ground_locs)},
		# Priority 4: emergency descent (descend first on low battery or communication failure)
		{emergency_move_down_battery_low, emergency_move_down_battery_low_to_empty, emergency_move_down_battery_empty, emergency_move_down_comm, emergency_move_down_both_1, emergency_move_down_both_1_to_empty, emergency_move_down_both_2},
		# Priority 5: nominal movement + nominal landing (same priority group, may compete) + state changes
		{move_forward, move_back, move_left, move_right, move_forward_left, move_forward_right, move_back_left, move_back_right, move_up, move_down, landing_normal(ground_locs),comm_failure, battery_consumption}
	];
	preds = {
		# ========== Safety verification ==========
		collision,
		
		# ========== Reachability verification ==========
		drone_at_v0, 
		drone_at_v8, 
		drone_at_ground(ground_locs), 
		v0_empty,
		drone_landed, drone_flying,
		drone_landed_safe,
		drone_at_charger,
		
		# ========== Rule completeness verification ==========
		drone_battery_low, drone_battery_normal, drone_battery_empty,
		drone_comm_bad, drone_comm_normal,
		drone_flying_battery_low, drone_flying_battery_empty, drone_flying_comm_bad,
		drone_flying_emergency_1, drone_flying_emergency_2,
		drone_emergency_landed_1, drone_emergency_landed_2,
		drone_comm_los_landed,
		drone_battery_low_landed, drone_battery_empty_landed,
		drone_charging_1, drone_charging_2,

		# identity-bound predicates (see Q2.6 / Q3 fixes above)
		drone_lowbatt_at_charger, drone_emptybatt_at_charger,
		drone_landed_in_air
	};
end
