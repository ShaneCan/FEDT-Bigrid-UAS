// =====================================================================
// Tier-1 qualitative verification queries for uavs_3d_verified_2x2x2.big.
//
// The verified model is explored to a fixpoint (2160 states, 4998
// transitions, 100% reachable-space coverage), so results are exact over
// the complete reachable space and do not depend on an exploration bound.
//
// Because the reaction weights are operational (not calibrated against
// field data), we report qualitative properties rather than probability
// values: safety/consistency invariants P=?[G phi] (evaluate to 1) and
// existential reachability P>0[F phi] (booleans, "the rule set admits
// this behaviour"). Physical probabilities are not claimed.
//
// Run with run_verified_analysis.sh (bigrapher full, then PRISM -dtmc).
// =====================================================================

// ---- Q1 Safety: grid-level co-occupancy exclusion (expected 1) -------
P=? [G !"collision"]

// ---- Q2 Reachability (existential; "admitted by the rule set") -------
// Q2.1 any landing reachable
P>0 [F "drone_landed"]
// Q2.2 nominal safe landing reachable
P>0 [F "drone_landed_safe"]
// Q2.3 low/empty-battery landing reachable
P>0 [F ("drone_battery_low_landed" | "drone_battery_empty_landed")]
// Q2.4 communication-loss landing reachable
P>0 [F "drone_comm_los_landed"]
// Q2.5 compound-fault emergency landing reachable
P>0 [F ("drone_emergency_landed_1" | "drone_emergency_landed_2")]
// Q2.6 low/empty-battery drone AT a charger (identity-bound; same vehicle)
P>0 [F ("drone_lowbatt_at_charger" | "drone_emptybatt_at_charger")]
// Q2.7 charging initiation reachable
P>0 [F ("drone_charging_1" | "drone_charging_2")]

// ---- Q3 Consistency: no landed UAS at an air locale (expected 1) -----
P=? [G !"drone_landed_in_air"]

// ---- Q4 Progress (liveness): an all-landed configuration is reachable -
P>0 [F !"drone_flying"]

// ---- Q5 Deadlock-freedom (no gridlock) -------------------------------
// Checked structurally by run_verified_analysis.sh: every reachable
// deadlock (no enabled rule) is an all-landed terminal configuration;
// no deadlock state contains a still-flying UAS. Reported as a table row.
